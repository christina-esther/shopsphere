# Frontend environment variables
# Rename to .env and fill in your values

# API URL (backend)
VITE_API_URL=http://localhost:5000/api

# Stripe publishable key (for client-side Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Razorpay key id (for client-side Razorpay)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx
